#!/bin/zsh

# Without this, the script continues even if a command fails. With this, the script stops at the first command that fails.
set -e

# Base directories (override the root with the CQ_ROOT environment variable)
ROOT_DIR="${CQ_ROOT:-$HOME/aa/code/_cq}"
REALS_DIR="$ROOT_DIR/reals"
LINKS_DIR="$ROOT_DIR/links"

# Ensure base directories exist
mkdir -p "$REALS_DIR" "$LINKS_DIR"

# App/editor aliases for `cq open`. To support a new app, just add it here;
# usage, help, and error messages derive from this table.
typeset -A OPEN_APPS
OPEN_APPS=(
  fx  open     # Finder
  vsc code     # Visual Studio Code
  cur cursor   # Cursor
  agy agy-ide  # Antigravity
  zed zed      # Zed
)

print_err() { echo "\033[31m$*\033[0m" 1>&2; }

require_arg() {
  local got="$1"; local msg="$2"
  if [[ -z "$got" ]]; then
    print_err "$msg"; exit 2
  fi
}

link_exists() {
  [[ -L "$LINKS_DIR/$1" ]]
}

get_real_id_from_link_name() {
  local link_name="$1"
  local target
  target=$(readlink "$LINKS_DIR/$link_name") || return 1
  basename "$target"
}

get_real_path_from_link_name() {
  local link_name="$1"
  local real_id
  real_id=$(get_real_id_from_link_name "$link_name") || return 1
  echo "$REALS_DIR/$real_id"
}

# Sanitize a name to kebab-case
sanitize_name() {
  local name="$1"
  # Convert to lowercase, replace spaces and underscores with hyphens,
  # remove non-alphanumeric except hyphens, collapse multiple hyphens
  echo "$name" | tr '[:upper:]' '[:lower:]' | tr ' _' '-' | sed 's/[^a-z0-9-]//g' | sed 's/--*/-/g' | sed 's/^-//;s/-$//'
}

# Newest modification time first; record_access bumps a link's timestamp.
# ls skips dotfiles by default, and the links dir always exists (mkdir -p
# above), so no filtering or fallback is needed.
get_sorted_links() {
  ls -1t "$LINKS_DIR"
}

record_access() {
  touch -h "$LINKS_DIR/$1" 2>/dev/null || true
}

# Select a link name. An exact match on $2 skips fzf entirely; a partial
# name prefills fzf's search (auto-selecting when only one link matches).
select_link() {
  local prompt="$1"
  local query="${2:-}"

  if [[ -n "$query" ]] && link_exists "$query"; then
    echo "$query"
    return 0
  fi

  local -a fzf_args
  fzf_args=(--height=40% --reverse --prompt="$prompt")
  [[ -n "$query" ]] && fzf_args+=(--query="$query" --select-1)
  get_sorted_links | fzf "${fzf_args[@]}"
}

set_window_title() {
  local real_path="$1"
  local link_name="$2"
  local settings_dir="$real_path/.vscode"
  local settings_file="$settings_dir/settings.json"
  
  mkdir -p "$settings_dir"
  
  if [[ -f "$settings_file" ]]; then
    # Merge with existing settings. jq fails on JSONC (comments etc.); the
    # title is cosmetic, so warn and continue instead of aborting the command.
    if jq --arg title "$link_name" '. + {"window.title": $title}' "$settings_file" > "$settings_file.tmp" 2>/dev/null; then
      mv "$settings_file.tmp" "$settings_file"
    else
      rm -f "$settings_file.tmp"
      print_err "Warning: could not update $settings_file (not valid JSON, e.g. contains comments)."
      print_err "Set \"window.title\" to \"$link_name\" manually if desired."
    fi
  else
    # Create new settings file
    jq -n --arg title "$link_name" '{"window.title": $title}' > "$settings_file"
  fi
}

# == COMMANDS BEGIN ==

cmd_ls() {
  if [[ $# -gt 1 ]]; then
    print_err "Usage: cq ls [PROJECT_NAME]"
    exit 2
  fi

  local selected
  selected=$(select_link "Select project: " "${1:-}") || return 1
  if [[ -z "$selected" ]]; then
    echo "Nothing selected"
    return 0
  fi

  record_access "$selected"
  echo -n "$selected" | pbcopy
  echo "Copied to clipboard: $selected"
}

cmd_lookup() {
  if [[ $# -gt 1 ]]; then
    print_err "Usage: cq lookup [PROJECT_NAME]"
    exit 2
  fi

  local query="${1:-}"
  local link_name real_id

  if [[ -n "$query" ]] && link_exists "$query"; then
    link_name="$query"
    real_id=$(get_real_id_from_link_name "$link_name") || { print_err "Failed to resolve real dir"; exit 1; }
  else
    local -a rows
    rows=()
    while IFS= read -r link_name; do
      real_id=$(get_real_id_from_link_name "$link_name") || real_id="???"
      rows+=("$real_id"$'\t\t'"$link_name")
    done < <(get_sorted_links)

    local -a fzf_args
    fzf_args=(--height=40% --reverse --prompt="Look up project: ")
    [[ -n "$query" ]] && fzf_args+=(--query="$query" --select-1)

    local selected
    selected=$(printf '%s\n' "${rows[@]}" | fzf "${fzf_args[@]}") || return 1
    if [[ -z "$selected" ]]; then
      echo "Nothing selected"
      return 0
    fi

    real_id="${selected%%$'\t'*}"
    link_name="${selected##*$'\t'}"
  fi

  record_access "$link_name"
  echo -n "$real_id" | pbcopy
  echo "Copied to clipboard: $real_id"
}

# Internal command used by wrapper. Wrapper handles the `cq cd` command.
cmd__cd() {
  local selected
  selected=$(select_link "cd into project: " "${1:-}") || return 1
  # stdout is the data channel here (the wrapper cds into whatever we print),
  # so user-facing messages must go to stderr.
  if [[ -z "$selected" ]]; then
    echo "Nothing selected" >&2
    return 0
  fi

  record_access "$selected"
  echo "$LINKS_DIR/$selected"
}

cmd_open() {
  local -a app_keys; app_keys=(${(ok)OPEN_APPS})
  local apps="${(j:|:)app_keys}"
  local app="$1"
  require_arg "$app" "Missing app/editor. Usage: cq open <$apps> [PROJECT_NAME]"

  local open_cmd="${OPEN_APPS[$app]:-}"
  if [[ -z "$open_cmd" ]]; then
    print_err "Unknown app/editor: $app. Valid options: $apps"
    exit 2
  fi

  local selected
  selected=$(select_link "Open project in app/editor: " "${2:-}") || return 1
  if [[ -z "$selected" ]]; then
    echo "Nothing selected"
    return 0
  fi

  record_access "$selected"
  local real_path
  real_path=$(get_real_path_from_link_name "$selected") || { print_err "Failed to resolve real path"; return 1; }
  $open_cmd "$real_path"
}

cmd_path() {
  local link_name="$1"
  require_arg "$link_name" "Missing project name. Usage: cq path <PROJECT_NAME>"
  if ! link_exists "$link_name"; then print_err "Link not found: $link_name"; exit 1; fi

  get_real_path_from_link_name "$link_name"
}

# Shared by mk and _mkcd. Prints the sanitized link name on stdout;
# all diagnostics go to stderr.
create_project() {
  local link_name_raw="$1"; local usage="$2"
  require_arg "$link_name_raw" "$usage"

  local link_name
  link_name=$(sanitize_name "$link_name_raw")
  if [[ -z "$link_name" ]]; then print_err "Sanitized name is empty"; exit 2; fi
  if link_exists "$link_name"; then print_err "Link already exists: $link_name"; exit 1; fi

  local real_path
  real_path=$(mktemp -d "$REALS_DIR/cq-XXXXXXXX") || { print_err "Failed to create real dir"; exit 1; }
  local real_id
  real_id=$(basename "$real_path")
  ln -s "../reals/$real_id" "$LINKS_DIR/$link_name" || { print_err "Failed to create symlink"; exit 1; }
  set_window_title "$real_path" "$link_name"

  echo "$link_name"
}

cmd_mk() {
  local link_name
  link_name=$(create_project "${1:-}" "Missing project name. Usage: cq mk <PROJECT_NAME>")

  echo "Created project: $link_name"
  get_real_path_from_link_name "$link_name"
}

# Internal command used by wrapper. Wrapper handles the `cq mkcd` command.
cmd__mkcd() {
  local link_name
  link_name=$(create_project "${1:-}" "Missing project name. Usage: cq mkcd <PROJECT_NAME>")

  # stdout is the data channel here (the wrapper cds into whatever we print),
  # so user-facing messages must go to stderr.
  echo "Created project: $link_name" >&2
  echo "$LINKS_DIR/$link_name"
}

cmd_cp() {
  local old_link_name="$1"; local suffix_raw="$2"
  require_arg "$old_link_name" "Missing old project name. Usage: cq cp <OLD_PROJECT_NAME> <NEW_PROJECT_SUFFIX>"
  require_arg "$suffix_raw" "Missing new project suffix. Usage: cq cp <OLD_PROJECT_NAME> <NEW_PROJECT_SUFFIX>"

  if ! link_exists "$old_link_name"; then print_err "Old link not found: $old_link_name"; exit 1; fi
  local suffix
  suffix=$(sanitize_name "$suffix_raw")
  if [[ -z "$suffix" ]]; then print_err "Sanitized suffix is empty"; exit 2; fi
  local new_link_name="${old_link_name}__${suffix}"
  if link_exists "$new_link_name"; then print_err "New link already exists: $new_link_name"; exit 1; fi

  local old_real_id new_real_path new_real_id
  old_real_id=$(get_real_id_from_link_name "$old_link_name") || { print_err "Failed to resolve old real id"; exit 1; }
  new_real_path=$(mktemp -d "$REALS_DIR/cq-XXXXXXXX") || { print_err "Failed to create new real dir"; exit 1; }
  new_real_id=$(basename "$new_real_path")

  # Copy contents, preserving attributes (-a); clone/copy-on-write when possible (-c)
  cp -a -c "$REALS_DIR/$old_real_id/" "$new_real_path/" || { print_err "Failed to copy contents"; exit 1; }
  ln -s "../reals/$new_real_id" "$LINKS_DIR/$new_link_name" || { print_err "Failed to create symlink"; exit 1; }
  set_window_title "$new_real_path" "$new_link_name"

  echo "Created copy: $new_link_name"
}

cmd_rename() {
  local old_link_name="$1"; local new_link_name_raw="$2"
  require_arg "$old_link_name" "Missing old project name. Usage: cq rename <OLD_PROJECT_NAME> <NEW_PROJECT_NAME>"
  require_arg "$new_link_name_raw" "Missing new project name. Usage: cq rename <OLD_PROJECT_NAME> <NEW_PROJECT_NAME>"

  local new_link_name
  new_link_name=$(sanitize_name "$new_link_name_raw")
  if ! link_exists "$old_link_name"; then print_err "Old link not found: $old_link_name"; exit 1; fi
  if [[ -z "$new_link_name" ]]; then print_err "Sanitized new link name is empty"; exit 2; fi
  if link_exists "$new_link_name"; then print_err "New link already exists: $new_link_name"; exit 1; fi

  mv "$LINKS_DIR/$old_link_name" "$LINKS_DIR/$new_link_name"
  
  local real_path
  real_path=$(get_real_path_from_link_name "$new_link_name") || { print_err "Failed to resolve real path"; exit 1; }
  set_window_title "$real_path" "$new_link_name"

  echo "Renamed to: $new_link_name"
}

cmd_rm() {
  local link_name="$1"
  require_arg "$link_name" "Missing project name. Usage: cq rm <PROJECT_NAME>"

  if ! link_exists "$link_name"; then print_err "Link not found: $link_name"; exit 1; fi

  local real_id real_path
  real_id=$(get_real_id_from_link_name "$link_name") || { print_err "Failed to resolve real dir"; exit 1; }
  real_path="$REALS_DIR/$real_id"
  if [[ ! -d "$real_path" ]]; then print_err "Real dir missing: $real_path"; exit 1; fi

  # This ain' no atomic, cuz I ain' no nuclear engineer.
  # (jk I just don't care about this project that much)
  trash "$real_path" || { print_err "Failed to trash real dir"; exit 1; }
  trash "$LINKS_DIR/$link_name" || { print_err "Failed to trash link (real dir already trashed)"; exit 1; }

  echo "Removed: $link_name"
}

# == COMMANDS END ==

main() {
  local cmd="${1:-}"
  [[ $# -gt 0 ]] && shift

  case "$cmd" in
    ls)        cmd_ls "$@" ;;
    lookup)    cmd_lookup "$@" ;;
    _cd)       cmd__cd "$@" ;;
    open)      cmd_open "$@" ;;
    mk)        cmd_mk "$@" ;;
    _mkcd)     cmd__mkcd "$@" ;;
    cp)        cmd_cp "$@" ;;
    rename)    cmd_rename "$@" ;;
    path)      cmd_path "$@" ;;
    rm)        cmd_rm "$@" ;;
    ""|help|-h|--help)
      local -a app_keys; app_keys=(${(ok)OPEN_APPS})
      local apps="${(j:|:)app_keys}"
      cat <<EOF
Usage: cq <command> [...args]
Commands:
  help                                            Show this help message
  ls [PROJECT_NAME]                               List projects, copy selection to clipboard
  lookup [PROJECT_NAME]                           List real dir <-> project name mapping, copy selected real dir name
  cd [PROJECT_NAME]                               List projects, cd into selected one
  open <$apps> [PROJECT_NAME]        List projects, open selected one in app/editor
  mk <PROJECT_NAME>                               Create new project, print its path
  mkcd <PROJECT_NAME>                             Create new project and cd into it
  cp <OLD_PROJECT_NAME> <NEW_PROJECT_SUFFIX>      Create a copy of an existing project
  rename <OLD_PROJECT_NAME> <NEW_PROJECT_NAME>    Rename a project
  path <PROJECT_NAME>                             Print absolute path of project
  rm <PROJECT_NAME>                               Move project to Trash

An optional PROJECT_NAME that matches exactly skips the menu; otherwise it
prefills the fuzzy search (auto-selecting when only one project matches).
The cd and mkcd commands require the zsh wrapper (contrib/cq.zsh).
EOF
      ;;
    *) print_err "Unknown command: $cmd"; exit 2 ;;
  esac
}

main "$@"
